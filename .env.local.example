NEXT_PUBLIC_SUPABASE_URL=https://ripnymdxplmoflpwmqwl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://team.facturmfg.com
NEXT_PUBLIC_LMS_NAME=Team Learning Academy
NEXT_PUBLIC_ISSUER_NAME=Training Department
RESEND_API_KEY=

# Gaib. The key is read by the chat endpoint; the GitHub token is what lets a
# ticket start the agent workflow, and needs `repo` and `workflow` scope.
ANTHROPIC_API_KEY=
GAIB_GITHUB_TOKEN=
# Only if the agent should run somewhere other than gabedraper/factur-team on main.
GAIB_REPO=gabedraper/factur-team
GAIB_BRANCH=main
LOXO_API_KEY=
LOXO_AGENCY_SLUG=

# The Cloud project the Google Chat app lives in. Every message Google sends is
# signed for this project; without it nothing can be verified and the endpoint
# refuses everything, which is the correct way for it to fail.
GOOGLE_CHAT_PROJECT_NUMBER=869809248052

# Protects the endpoint that pushes ticket updates into Google Chat. Any random
# string; it only has to match between Vercel and whatever calls it.
GAIB_DELIVER_SECRET=

# Dialer. Telnyx is the current primary path (Plan C -- Twilio's own signup
# couldn't deliver a 2FA code after repeated tries; Dialpad's Mini Dialer
# approval is still pending). TELNYX_CREDENTIAL_ID is a telephony credential
# created once in the Telnyx portal/API, not a Twilio-style app SID.
TELNYX_API_KEY=
TELNYX_CREDENTIAL_ID=
TELNYX_PUBLIC_KEY=

# API Key/Secret are a Twilio API Key pair, not the Auth Token; Auth Token is
# separately required to verify that app/api/twilio/voice is genuinely being
# called by Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_AUTH_TOKEN=
# Issued by Dialpad once the Mini Dialer integration request clears.
NEXT_PUBLIC_DIALPAD_CTI_CLIENT_ID=
